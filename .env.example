# 博客 · 环境变量样例
# ─────────────────────────────────────────────────────────────
# 复制为 `.env`（本地开发可放 `.env.local`）后按需填写。
# `.env` 已被 gitignore —— 请勿把真实信息写回代码或提交进仓库。
# 站点身份类全部可选：留空时相关位置会自动隐藏（不会出现空链接/空白块）。
# ─────────────────────────────────────────────────────────────

# ── 站点身份 ────────────────────────────────────────────────
# 站点名（导航 / 页脚 / 元信息 / RSS）
SITE_NAME=我的博客
# 一句话口号（页脚 / 关于页 / llms.txt；留空则不显示）
SITE_SLOGAN=
# 站点地址（RSS / sitemap / 分享 / 友链模板；末尾不带斜杠）
SITE_URL=http://localhost:3000
# 建站日 YYYY-MM-DD（页脚「建站 N 天」；留空则不显示）
SITE_START_DATE=
# GitHub 用户名（关于页 / 友链 / 侧栏 GitHub 卡片；留空则相关入口隐藏）
SITE_GITHUB=
# ICP 备案号文本（页脚；留空则不显示）
SITE_ICP=
# 公安备案号文本（页脚；留空则不显示）
SITE_POLICE=
# 公安备案号查询码（用于生成页脚备案链接；留空则无链接）
SITE_POLICE_CODE=

# ── 管理后台（必填）──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 会话签名密钥：请填一段随机字符串（≥32 字符）
AUTH_SECRET=please-generate-a-long-random-string

# ── 评论区（giscus，可选；留空则文章页不显示评论区）───────────
# 到 https://giscus.app/zh-CN 生成后填入
COMMENTS_REPO=
COMMENTS_REPO_ID=
COMMENTS_CATEGORY=Announcements
COMMENTS_CATEGORY_ID=

# ── 工作站 /w（可选；不跑这些服务就留空）──────────────────────
# 内嵌 MQTT broker（给设备发账号、收上报）
MQTT_ENABLED=false
MQTT_PORT=18830
MQTT_WS_ENABLED=false
MQTT_WS_PORT=18831
MQTT_WS_PATH=/mqtt-ws
# 宿主机端口绑定地址（docker-compose 用；默认只绑本机，由反代转发）
BIND_ADDR=127.0.0.1
# ESP32 OTA 设备令牌（设备拉固件时校验；留空则不校验）
OTA_TOKEN=
# GeoIP 数据库下载地址（留空则访客地区不做解析）
GEOIP_URL=
# 本地素材工具（scripts/imgtool，走 ssh 上传到服务器）
IMGTOOL_SSH=
IMGTOOL_SITE=
IMGTOOL_REMOTE=

# ── 可选 ───────────────────────────────────────────────────
# GitHub API 令牌（提高侧栏 GitHub 卡片的接口限额）
GITHUB_TOKEN=
