# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# runtime data（搜索索引等，运行时生成）
/data/*
!/data/.gitkeep

# 图片：服务器主存（机械盘）+ 云盘备份，不进 git（用「图片工具」上传到服务器）
/content/images/*
!/content/images/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# opencode 本地配置（个人工具，不入库）
/opencode.json
